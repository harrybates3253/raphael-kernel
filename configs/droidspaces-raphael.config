# ============================================================
# Droidspaces + KernelSU kernel config fragment
# 目标: Xiaomi raphael / cepheus (SM8150, msmnile, kernel 4.14.x)
# 基线: raphael_stock_defconfig (Laulan56/android_kernel_xiaomi_sm8150 @ android14)
# 用法: cp 到 arch/arm64/configs/vendor/droidspaces.config
#       make O=out raphael_stock_defconfig vendor/droidspaces.config
#
# 基线实测缺口（2026-10 实测该 defconfig, 共 5030 个选项）:
#   已是 y: SYSCTL/IPC 内核基础、NAMESPACES、UTS_NS、NET_NS、SECCOMP(_FILTER)、
#           CGROUPS/CGROUP_SCHED/FAIR_GROUP_SCHED/CGROUP_FREEZER/CGROUP_CPUACCT、
#           MEMCG、OVERLAY_FS、TMPFS_XATTR、VETH、BRIDGE、NFTABLES 以外的多数 netfilter
#   是 n  : SYSVIPC POSIX_MQUEUE PID_NS CGROUP_DEVICE CGROUP_NET_PRIO CGROUP_PIDS
#           DEVTMPFS NF_TABLES XT_MATCH_ADDRTYPE IP6_NF_NAT NF_NAT_IPV6 MACVLAN
#           USER_NS KPROBES  <- 注意 KPROBES 默认关闭，KernelSU 的 kprobe 方案必须打开
#   不存在: IPC_NS CFS_BANDWIDTH FW_LOADER_COMPRESS XT_TARGET_MASQUERADE
#           NF_CONNTRACK_NETLINK IP6_NF_TARGET_MASQUERADE
# 下面逐条补齐，并把 KernelSU / 容器运行必需项写死。
# ============================================================

# ---------- IPC ----------
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ---------- 命名空间（Droidspaces 起容器的硬门槛）----------
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y

# ---------- Seccomp ----------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---------- Cgroup ----------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_CPUACCT=y
# --memory / --cpus / --pids-limit
CONFIG_MEMCG=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
# 4.8+ 才有；老树上写进去 Kconfig 会忽略
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y

# ---------- 文件系统 ----------
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_TUN=y

# ---------- 固件加载 ----------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# ---------- 网络隔离（NAT / none / macvlan）----------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# IPv6 / NAT66（缺了就只是 IPv4-only 容器）
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT_IPV6=y

# macvlan 模式
CONFIG_MACVLAN=y

# 老内核上必须关掉，否则容器没网
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# ---------- UFW / fail2ban（可选，跑家庭服务器时用）----------
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_TARGET_ULOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# ---------- KernelSU（kprobe 方案，非 GKI 4.14 唯一可用路线）----------
# 官方文档 kernel/setup.sh + how-to-integrate-for-non-gki 明写三个都要 y:
#   CONFIG_KPROBES=y / CONFIG_HAVE_KPROBES=y / CONFIG_KPROBE_EVENTS=y
# arm64 的 HAVE_KPROBES 由 arch/arm64/Kconfig select，这里显式写一遍保证 merge 后仍在
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# KSU 自身的 Kconfig: config KSU 依赖 KPROBES && EXT4_FS, default y —— 显式写死更保险
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
# LSM 安全 hook 会动 security_hook_heads，4.14 上容易早期 panic；只保留 kprobe 方案
# CONFIG_KSU_LSM_SECURITY_HOOKS is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_MODULES=y
# 让第三方模块（厂商 /vendor/lib/modules 里的 .ko）能加载
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_PROTECT is not set

# ---------- 调试信息 ----------
# v1（44.7MB Image）在 raphael 上卡 logo 重启，首要嫌疑是 boot 分区放不下 +
# KSU 的 LSM hook 在 4.14 vendor 内核上早期崩。v2 两个都关掉。
# CONFIG_DEBUG_INFO is not set
